DATABASE_URL=

# Comma-separated emails. The first successful sign-in for an address on this
# list creates an admin. It does not promote or re-enable an existing user.
# Editor and reviewer are a SQL update:
#   update users set role = 'editor' where email = 'name@example.org';
# Leave this empty until the migration drizzle/0014_admin_cms.sql has been applied.
ADMIN_EMAILS=

APP_URL=https://www.climaterefugeepavilion.org

RESEND_API_KEY=
RESEND_FROM="Climate Refugee Pavilion <apply@your-domain>"
RESEND_WEBHOOK_SECRET=

# --- Secrets (each 32+ random characters in production) ---
# Signs applicant sessions, rate-limit keys, and recovery tokens.
APP_SECRET=
# Individual operations credentials: JSON array of {id, tokenHash}.
# Generate one credential per operator with node scripts/create-operator.mjs <id>.
OPERATIONS_TOKENS=[]
# Vercel Cron sends this as a bearer token to /api/cron/jobs (the job worker).
CRON_SECRET=
# Shared secret guarding the Power Automate sync endpoints.
SYNC_API_SECRET=
# Excel/Sheets sync skips rows whose email contains any of these (comma-separated,
# case-insensitive). Defaults to "+crptest"; set it empty to sync everything.
SYNC_EXCLUDE_EMAIL_PATTERN=+crptest

# --- Excel review workbook ---
# All five GRAPH_* values make /api/cron/excel edit CRP-Review.xlsx in SharePoint.
# With none of them set, the cron uses Google Sheets when that pair is set, and skips when it is not.
# Entra app with Microsoft Graph application permission Files.ReadWrite.All, admin-consented.
# Never put the client secret in the workbook or in git.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# CRP-Review.xlsx in SharePoint or OneDrive for Business. Resolve the ids once:
# GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site}:/drive/root:/CRP-Review.xlsx
# parentReference.driveId is GRAPH_DRIVE_ID. id is GRAPH_ITEM_ID.
# GRAPH_DRIVE_ID=
# GRAPH_ITEM_ID=

# --- VideoAsk ---
# Set per Vercel environment: Preview/dev points at the TEST-folder form,
# Production at the live form. Each form's webhook goes to its own deployment:
#   Production: https://www.climaterefugeepavilion.org/api/webhooks/videoask
#   Preview/dev: https://pavilion-landing-page.vercel.app/api/webhooks/videoask?x-vercel-protection-bypass=<Protection Bypass for Automation secret>
# Events from another environment's form are acknowledged (200) and ignored.
# One shared secret, sent by every form as the x-webhook-secret header.
VIDEOASK_WEBHOOK_SECRET=
# Entry URL applicants open (language picker or single form).
VIDEOASK_FORM_URL=
# Form ids whose completion webhooks we accept. Single-form: set FORM_ID.
# Language-split: set FORM_ID_EN/FR/ES (and optionally keep FORM_ID as one of
# them). Extra ids can be comma-listed in FORM_IDS. Point every language form
# at the same webhook URL and secret; each must pass application_ref.
VIDEOASK_FORM_ID=
VIDEOASK_FORM_ID_EN=
VIDEOASK_FORM_ID_FR=
VIDEOASK_FORM_ID_ES=
VIDEOASK_FORM_IDS=
# VideoAsk final-step redirect (Logic → Redirect to URL), with @application_ref:
#   {APP_URL}/api/apply/verify?ref=@application_ref
# It only routes the applicant onward; the signed webhook completes Round 1.
# Configure that redirect on every language form.

DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=
# Private Blob reads use BLOB_READ_WRITE_TOKEN off Vercel and OIDC on Vercel.
# PROGRAM_END is the last UTC day of the program, YYYY-MM-DD. Unset or invalid
# skips media deletion.
# MEDIA_RETENTION_DAYS defaults to 30. A value outside 1 through 3650 is treated as 30.
# MEDIA_RETENTION_DRY_RUN deletes only when the value is exactly false.
# Any other value, including unset, is a dry run.
PROGRAM_END=
MEDIA_RETENTION_DAYS=
MEDIA_RETENTION_DRY_RUN=
# Optional. Interview booking is on only when all three URLs are set and
# CALENDLY_ENABLED is not "false"; without them accepted applicants get a
# no-button email and the team arranges interviews directly.
CALENDLY_ENABLED=
CALENDLY_URL_EN=
CALENDLY_URL_FR=
CALENDLY_URL_ES=
CALENDLY_WEBHOOK_SIGNING_KEY=
# Used only by scripts/register-calendly-webhook.mjs.
CALENDLY_PERSONAL_ACCESS_TOKEN=
MIN_APPLICANT_AGE=19
MAX_APPLICANT_AGE=26
CONSENT_VERSION=v1

# PostHog analytics (project API key, public). Loaded only after a visitor allows
# analytics cookies; leave the key empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Add the custom variable application_ref to the VideoAsk form.
# Configure x-webhook-secret in VideoAsk; query-string secrets are not accepted.
